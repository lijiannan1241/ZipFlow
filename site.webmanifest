{
  "name": "ZipFlow — Know before you unzip",
  "short_name": "ZipFlow",
  "description": "A local-first archive tool for Windows that checks archive safety before extraction and recommends compression settings.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#0a1220",
  "lang": "en",
  "icons": [
    {
      "src": "assets/img/icon-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
